`timescale 1ps / 1ps
`define NULL 0

// Author: Amina Tankovic
// Description: Encryption block takes the data from pcap reader (delayed through FIFO) and the final key (from key provider+scheduler). 
//              It generates final data using XOR encryption and prepares the rest of Avalon-ST signals. 

module encryption_block#(                                     
) (
    input clk,
    input rst, 
    avalon_if.in    from_key_scheduler,
    avalon_if.in    from_reader_register,
    avalon_if.out   encrypted
);


always_ff @(posedge clk) begin 
    if(rst) begin
        encrypted.data <= '0;
        encrypted.valid <= 0;
        encrypted.sop <= 0;
        encrypted.eop <= 0;
        encrypted.empty <= '0; 
        encrypted.channel <= '0;
    end else if(encrypted.ready) begin
        encrypted.valid <= from_reader_register.valid && from_key_scheduler.valid;
        if(from_reader_register.valid && from_key_scheduler.valid) begin
           encrypted.data <= from_key_scheduler.data ^ from_reader_register.data; //XOR encryption
           encrypted.sop <= from_reader_register.sop;
           encrypted.eop <= from_reader_register.eop;
           encrypted.empty <= from_reader_register.empty;
           encrypted.channel <= '0;
        end
    end else if (from_reader_register.valid == 0 && from_key_scheduler.valid == 0) begin
        encrypted.valid <= 0;
        encrypted.sop <= 0;
        encrypted.eop <= 0;
        encrypted.empty <= '0;
        encrypted.channel <= '0;
    end
    
   
end 
     assign from_reader_register.ready = encrypted.ready && from_reader_register.valid && from_key_scheduler.valid;  //towards Avalon-ST FIFO placed after pcap reader   
     assign from_key_scheduler.ready = encrypted.ready && from_reader_register.valid && from_key_scheduler.valid;   //towards Avalon-ST FIFO placed after key provider+scheduler

endmodule
