`timescale 1ps / 1ps
`define NULL 0

module pcap_reader_writer_test;

    // Inputs
    logic clk = 0;
    logic rst = 1;
    logic available;
    logic [4:0] pktcount;
    logic pcapfinished;
    parameter DATA_WIDTH = 512;
    parameter SIGNAL_TYPE = "avalon";
  
    avalon_if #(.DATA_WIDTH(DATA_WIDTH)) avalon_int(.clk(clk),.rst(rst));
    axis_if #(.DATA_WIDTH(DATA_WIDTH)) axis_int(.clk(clk),.rst(rst));

    pcapreader #(
        .PCAP_FILENAME( "amina50.pcap" ),
        .SIGNAL_TYPE(SIGNAL_TYPE),
        .DATA_WIDTH(DATA_WIDTH)
    ) pcap (
	.clk_out(clk),
        .reset(rst),
        .available(available),
        .pktcount(pktcount),
	.pcapfinished(pcapfinished),

	.from_reader_avalon(avalon_int),
        .from_reader_axis(axis_int)
    );

    pcapwriter #(
	.PCAP_FILENAME( "novipcap_reader_writer_test.pcap" ),
        .SIGNAL_TYPE(SIGNAL_TYPE),
        .DATA_WIDTH(DATA_WIDTH)
    ) pcapwr (
	.clk_in(clk),
	.reset(rst),

	.to_writer_avalon(avalon_int),
        .to_writer_axis(axis_int)
    );

    integer clock_period = 5120;
    always #(clock_period/2) clk = ~clk;
	

    integer i = 0;

    initial begin

        $dumpfile("novi1.txt");
        $dumpvars(0);
        avalon_int.ready <= 1;

        #clock_period;
        rst <= 0;
        #(2*clock_period);
        //avalon_int.ready <= 0;
        #(3*clock_period);
        //avalon_int.ready <= 1;
		
        while (~pcapfinished) begin
	    #20
	    i = i+1;
	end

	#(2*clock_period);

	$finish;

    end

endmodule