/*
  Avalon_pipeline_register module - axis_avalon_pipeline module (by Alex Forencich) wrapped with Avalon ST input/output interface 
*/

module avalon_pipeline_register (
    input logic clk,
    input logic rst,
    avalon_if.in input_avalon,
    avalon_if.out output_avalon
);
   
axis_pipeline_register #(
     .DATA_WIDTH(512),
     .REG_TYPE(2),    //skid buffer
     .LENGTH(2),      //number of registers
     .USER_WIDTH(17)  //axis signal "user" will be used for transmission of several information from avalon interface: sop(1) + empty(6) + channel(10)
    ) register (

     .clk(clk),
     .rst(rst),
     .s_axis_tdata(input_avalon.data),
     .s_axis_tkeep('1),
     .s_axis_tvalid(input_avalon.valid),
     .s_axis_tready(input_avalon.ready),
     .s_axis_tlast(input_avalon.eop),
     .s_axis_tid('0),
     .s_axis_tdest('0),
     .s_axis_tuser({input_avalon.sop, input_avalon.empty, input_avalon.channel}),

     .m_axis_tdata(output_avalon.data),
     .m_axis_tkeep(),
     .m_axis_tvalid(output_avalon.valid),
     .m_axis_tready(output_avalon.ready),
     .m_axis_tlast(output_avalon.eop),
     .m_axis_tid(),
     .m_axis_tdest(),
     .m_axis_tuser({output_avalon.sop, output_avalon.empty, output_avalon.channel})

    );

//assign input_avalon.ready = output_avalon.ready;
endmodule


